#!/bin/bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

EXECUTABLE_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$EXECUTABLE_DIR/../../.." && pwd)"
LOCAL_DIR="$REPO_ROOT/.local"
EVIDENCE_DIR="$LOCAL_DIR/codex-evidence"
CODEX_CREDENTIAL_DIR="$LOCAL_DIR/codex-home"
LOG_FILE="$LOCAL_DIR/launcher.log"
RUN_SCRIPT="$REPO_ROOT/hosting/docker-compose/run.sh"
COMPOSE_OVERLAY="docker-compose.dev.rolling-skill.yml"
ENV_FILE_NAME=".env.oss.dev"

mkdir -p "$LOCAL_DIR" "$EVIDENCE_DIR" "$CODEX_CREDENTIAL_DIR"
touch "$LOG_FILE"
exec >>"$LOG_FILE" 2>&1

show_error() {
    local detail="$1"
    /usr/bin/osascript -e "display dialog \"Rolling Skill could not stop.\\n\\n${detail}\\n\\nLog: ${LOG_FILE}\" buttons {\"OK\"} default button \"OK\" with icon stop" >/dev/null 2>&1 || true
}

echo ""
echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] Stopping Rolling Skill"

[[ -f "$RUN_SCRIPT" ]] || {
    show_error "The Agenta checkout is incomplete: hosting/docker-compose/run.sh is missing."
    exit 1
}
if [[ ! -f "$REPO_ROOT/hosting/docker-compose/oss/$ENV_FILE_NAME" ]]; then
    ENV_FILE_NAME="env.oss.dev.example"
fi

export ROLLING_SKILL_EVIDENCE_DIR="$EVIDENCE_DIR"
export ROLLING_SKILL_CODEX_HOME_DIR="$CODEX_CREDENTIAL_DIR"
cd "$REPO_ROOT"
if /bin/bash "$RUN_SCRIPT" \
    --oss \
    --dev \
    --no-tunnel \
    --env-file "$ENV_FILE_NAME" \
    --compose-file "$COMPOSE_OVERLAY" \
    --down; then
    echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] Rolling Skill stopped"
    /usr/bin/osascript -e 'display notification "Agenta stopped. Data and evidence were kept." with title "Rolling Skill"' >/dev/null 2>&1 || true
else
    show_error "Docker Compose could not stop the stack."
    exit 1
fi
