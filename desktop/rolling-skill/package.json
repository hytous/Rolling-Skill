{
    "name": "rolling-skill-desktop",
    "version": "0.3.0",
    "private": true,
    "author": "Rolling Skill",
    "description": "Native-window macOS client for the Rolling Skill evaluation workbench",
    "main": "src/main.cjs",
    "scripts": {
        "start": "electron .",
        "test": "node --test test/*.test.cjs",
        "pack:mac": "electron-builder --mac dir --arm64",
        "dist:mac": "electron-builder --mac dmg zip --arm64"
    },
    "devDependencies": {
        "@openai/codex": "0.147.0",
        "electron": "^43.3.0",
        "electron-builder": "^26.0.12"
    },
    "build": {
        "appId": "com.rolling-skill.desktop",
        "productName": "Rolling Skill",
        "asar": true,
        "files": [
            "src/**/*",
            "renderer/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin",
                "to": "codex-runtime"
            }
        ],
        "directories": {
            "output": "dist",
            "buildResources": "assets"
        },
        "mac": {
            "target": [
                "dir"
            ],
            "category": "public.app-category.developer-tools",
            "minimumSystemVersion": "13.0",
            "darkModeSupport": true,
            "icon": "assets/icon.svg.png",
            "identity": null
        }
    }
}
