#!/bin/bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

EXECUTABLE_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$EXECUTABLE_DIR/../../.." && pwd)"
LOCAL_DIR="$REPO_ROOT/.local"
EVIDENCE_DIR="$LOCAL_DIR/codex-evidence"
CODEX_CREDENTIAL_DIR="$LOCAL_DIR/codex-home"
HOST_CODEX_AUTH="$HOME/.codex/auth.json"
ISOLATED_CODEX_AUTH="$CODEX_CREDENTIAL_DIR/auth.json"
LOG_FILE="$LOCAL_DIR/launcher.log"
LOCK_DIR="$LOCAL_DIR/launcher.lock"
ENV_FILE="$REPO_ROOT/hosting/docker-compose/oss/.env.oss.dev"
ENV_EXAMPLE="$REPO_ROOT/hosting/docker-compose/oss/env.oss.dev.example"
RUN_SCRIPT="$REPO_ROOT/hosting/docker-compose/run.sh"
COMPOSE_OVERLAY="docker-compose.dev.rolling-skill.yml"

mkdir -p "$LOCAL_DIR" "$EVIDENCE_DIR" "$CODEX_CREDENTIAL_DIR"
/bin/chmod 700 "$CODEX_CREDENTIAL_DIR"
touch "$LOG_FILE"

show_error() {
    local detail="$1"
    /usr/bin/osascript -e "display dialog \"Rolling Skill could not start.\\n\\n${detail}\\n\\nLog: ${LOG_FILE}\" buttons {\"OK\"} default button \"OK\" with icon stop" >/dev/null 2>&1 || true
}

notify() {
    local detail="$1"
    /usr/bin/osascript -e "display notification \"${detail}\" with title \"Rolling Skill\"" >/dev/null 2>&1 || true
}

fail() {
    local detail="$1"
    echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] ERROR: $detail" >>"$LOG_FILE"
    show_error "$detail"
    exit 1
}

cleanup() {
    /bin/rmdir "$LOCK_DIR" >/dev/null 2>&1 || true
}

if ! /bin/mkdir "$LOCK_DIR" >/dev/null 2>&1; then
    show_error "Another launch is already running. Wait for it to finish, or inspect the launcher log."
    exit 1
fi
trap cleanup EXIT

exec >>"$LOG_FILE" 2>&1
echo ""
echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] Starting Rolling Skill"
echo "Repository: $REPO_ROOT"

[[ -x "$RUN_SCRIPT" || -f "$RUN_SCRIPT" ]] || fail "The Agenta checkout is incomplete: hosting/docker-compose/run.sh is missing."
[[ -f "$ENV_EXAMPLE" ]] || fail "The Agenta development environment template is missing."
[[ -f "$REPO_ROOT/hosting/docker-compose/oss/$COMPOSE_OVERLAY" ]] || fail "The Rolling Skill Compose overlay is missing."

if [[ ! -d /Applications/Docker.app ]]; then
    fail "Docker Desktop is not installed in /Applications. Install it, then open Rolling Skill again."
fi

if ! command -v docker >/dev/null 2>&1; then
    fail "The Docker command is unavailable. Open Docker Desktop once, then open Rolling Skill again."
fi

if docker ps --filter "name=^/agenta-oss-dev-web-1$" --filter "status=running" --quiet 2>/dev/null | /usr/bin/grep -q . \
    && /usr/bin/curl --fail --silent --show-error --max-time 3 http://localhost/ >/dev/null 2>&1; then
    echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] Rolling Skill is already running"
    notify "Already running at http://localhost"
    /usr/bin/open http://localhost
    exit 0
fi

if [[ ! -s "$HOST_CODEX_AUTH" ]]; then
    echo "Codex login is missing: $HOST_CODEX_AUTH"
    choice="$(/usr/bin/osascript -e 'button returned of (display dialog "Codex is not signed in. Rolling Skill can start only after the host Codex login exists.\n\nChoose Open Terminal, run codex login, finish sign-in, then double-click Rolling Skill again." buttons {"Cancel", "Open Terminal"} default button "Open Terminal" with icon caution)' 2>/dev/null || true)"
    if [[ "$choice" == "Open Terminal" ]]; then
        /usr/bin/open -a Terminal "$REPO_ROOT"
    fi
    exit 2
fi

if [[ ! -s "$ISOLATED_CODEX_AUTH" || "$HOST_CODEX_AUTH" -nt "$ISOLATED_CODEX_AUTH" ]]; then
    /bin/cp "$HOST_CODEX_AUTH" "$ISOLATED_CODEX_AUTH"
    /bin/chmod 600 "$ISOLATED_CODEX_AUTH"
    echo "Refreshed isolated Codex credentials: $ISOLATED_CODEX_AUTH"
fi

if [[ ! -f "$ENV_FILE" ]]; then
    /bin/cp "$ENV_EXAMPLE" "$ENV_FILE"
    echo "Created local environment: $ENV_FILE"
fi

if ! docker info >/dev/null 2>&1; then
    notify "Starting Docker Desktop. First launch can take a minute."
    /usr/bin/open -a Docker
    docker_ready=false
    for _attempt in $(/usr/bin/seq 1 120); do
        if docker info >/dev/null 2>&1; then
            docker_ready=true
            break
        fi
        /bin/sleep 1
    done
    [[ "$docker_ready" == "true" ]] || fail "Docker Desktop did not become ready within two minutes."
fi

notify "Building and starting Agenta. First launch can take several minutes."
export ROLLING_SKILL_EVIDENCE_DIR="$EVIDENCE_DIR"
export ROLLING_SKILL_CODEX_HOME_DIR="$CODEX_CREDENTIAL_DIR"
cd "$REPO_ROOT"
/bin/bash "$RUN_SCRIPT" \
    --oss \
    --dev \
    --build \
    --no-tunnel \
    --env-file .env.oss.dev \
    --compose-file "$COMPOSE_OVERLAY" || fail "Agenta failed to build or start."

web_ready=false
for _attempt in $(/usr/bin/seq 1 300); do
    if /usr/bin/curl --fail --silent --show-error --max-time 3 http://localhost/ >/dev/null 2>&1; then
        web_ready=true
        break
    fi
    /bin/sleep 1
done
[[ "$web_ready" == "true" ]] || fail "Agenta started but http://localhost was not ready within five minutes."

echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] Rolling Skill is ready"
notify "Ready at http://localhost"
/usr/bin/open http://localhost
